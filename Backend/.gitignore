*.bak
*.bacpac
*.dacpac
*.mdf
*.ldf
*.ndf
*.trn
*.sqlite
*.db
exports/
*.csv
*.xlsx

# --- Local backups, legacy variants and temporary files ---------------
_backups/
*.orig
*.tmp
*.swp
*~
# Superseded module versions kept on disk only (not imported anywhere).
*_backup.py
*_backup_*.py
*_backup_v[0-9]*.py
app_backup_before_ai.py
ollama_grading_v[0-9]*.py

